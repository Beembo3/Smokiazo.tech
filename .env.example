# Required in Vercel Project Settings > Environment Variables
# Copy these to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or the legacy anon JWT. Safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (sb_secret_... / service-role equivalent).
# Only for server code such as route handlers. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional Figma pull script
FIGMA_TOKEN=
FIGMA_FILE_KEY=08Mu3KwXJjvI6CkkgjDXyL
